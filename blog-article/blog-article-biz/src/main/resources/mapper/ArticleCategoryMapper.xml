<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xzf.blog.article.biz.domain.mapper.ArticleCategoryMapper">
  <resultMap id="BaseResultMap" type="com.xzf.blog.article.biz.domain.dataobject.ArticleCategoryDO">
    <id column="id" jdbcType="BIGINT" property="id" />
    <result column="article_id" jdbcType="BIGINT" property="articleId" />
    <result column="category_id" jdbcType="BIGINT" property="categoryId" />
    <result column="create_time" jdbcType="TIMESTAMP" property="createTime" />
    <result column="update_time" jdbcType="TIMESTAMP" property="updateTime" />
  </resultMap>
  <sql id="Base_Column_List">
    id, article_id, category_id, create_time, update_time
  </sql>

  <select id="countArticlesByCategoryId" resultType="int">
    SELECT COUNT( ac.article_id)
    FROM article_category_rel ac
    WHERE ac.category_id = #{categoryId}
  </select>

</mapper>